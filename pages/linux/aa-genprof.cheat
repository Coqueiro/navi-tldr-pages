; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/linux/aa-genprof.md

% aa-genprof, linux

# Start generating a profile for a program
sudo aa-genprof <path_to_program>

# Specify a custom directory for profiles
sudo aa-genprof <__d___dir_> /<path_to_profiles> <path_to_program>

# Specify a custom logfile for profiling
sudo aa-genprof <__f___file_> /<path_to_logfile> <path_to_program>

# Display help
aa-genprof <__h___help_>
