; https://github.com/tldr-pages/tldr/blob/master/pages/common/idevicediagnostics.md

% idevicediagnostics, common

# Print diagnostics information
idevicediagnostics diagnostics

# Print mobilegestalt key values
idevicediagnostics mobilegestalt <key1> <key2>

# Shut down, restart, or sleep the device
idevicediagnostics <shutdown_restart_sleep>
