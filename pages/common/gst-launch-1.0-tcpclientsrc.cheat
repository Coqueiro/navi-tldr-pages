% gst-launch-1.0-tcpclientsrc, common

# Receive data from a server on localhost
gst-launch-1.0 tcpclientsrc ! <pipeline>

# Receive data from a server
gst-launch-1.0 tcpclientsrc host=<server_ip_address> ! <pipeline>
