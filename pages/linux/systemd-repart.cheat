; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/linux/systemd-repart.md

% systemd-repart, linux

# Grow the root partition (/) to all available disk space
systemd-repart

# Simulate repartitioning, showing the changes without applying them
systemd-repart --dry-run yes

# Grow root partition size to 10 gigabytes
systemd-repart --size 10G --root /
