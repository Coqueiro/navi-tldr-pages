; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/djxl.md

% djxl, common

# Decompress a JPEG XL image to another format
djxl <path_to_image>.jxl <path_to_output_ext>

# Benchmark decoding speed
djxl <path_to_image>.jxl --num_reps <repetitions> --num_threads <threads> --disable_output

# Display an extremely detailed help
djxl {{[-h -v -v|--help --verbose --verbose]}}
