; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/makensis.md

% makensis, common

# Compile an NSIS script
makensis <path_to_file_nsi>

# Compile an NSIS script in strict mode (treat warnings as errors)
makensis -WX <path_to_file_nsi>

# Display help for a specific command
makensis -CMDHELP <command>
