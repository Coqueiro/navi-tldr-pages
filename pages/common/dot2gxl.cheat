; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/dot2gxl.md

% dot2gxl, common

# Convert a DOT graph to GXL
dot2gxl <path_to_input_file_dot> -o <path_to_output_file_gxl>

# Convert DOT to GXL based on `.dot` input extension
dot2gxl <path_to_input_file_dot> ><path_to_output_file_gxl>

# Convert GXL to DOT based on `.gxl` input extension
dot2gxl <path_to_input_file_gxl> ><path_to_output_file_dot>
