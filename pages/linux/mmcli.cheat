; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/linux/mmcli.md

% mmcli, linux

# List available modems
mmcli <__L___list_modems_>

# List available modems and monitor for ones added or removed
mmcli <__M___monitor_modems_>

# Print information about a modem
mmcli <__m___modem_> <modem_number>

# Enable a modem
mmcli <__m___modem_> <modem_number> <__e___enable_>

# List SMS messages available on the modem
sudo mmcli <__m___modem_> <modem_number> --messaging-list-sms

# Delete a message from the modem, specifying its path
sudo mmcli <__m___modem_> <modem_number> --messaging-delete-sms <path_to_message_file>
