; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/sunos/prctl.md

% prctl, sunos

# Examine process limits and permissions
prctl <process_id>

# Examine process limits and permissions in machine parsable format
prctl -P <process_id>

# Get a specific limit for a running process
prctl -n process.max-file-descriptor <process_id>
