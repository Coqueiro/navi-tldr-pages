; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/osx/softwareupdate.md

% softwareupdate, osx

# List all available updates
softwareupdate <__l___list_>

# Download and install all updates
softwareupdate <__i___install_> <__a___all_>

# Download and install all recommended updates
softwareupdate <__i___install_> <__r___recommended_>

# Download and install a specific app
softwareupdate <__i___install_> <update_name>
