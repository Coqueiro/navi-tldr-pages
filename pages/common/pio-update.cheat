; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/pio-update.md

% pio-update, common

# Perform a full update of all packages, development platforms, and global libraries
pio update

# Update core packages only (skips platforms and libraries)
pio update --core-packages

# Simulate an update, checking for new versions of packages, platforms, and libraries without updating them
pio update --dry-run
