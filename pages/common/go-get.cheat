; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/go-get.md

% go-get, common

# Add a specified package to `go.mod` in module-mode or install the package in GOPATH-mode
go get <example_com_pkg>

# Modify the package with a given version in module-aware mode
go get <example_com_pkg>@<v1_2_3>

# Remove a specified package
go get <example_com_pkg>@<none>

# Update a package to its latest release
go get -u example.com/pkg

# Update direct dependencies
go get -u

# Update direct and indirect dependencies
go get -u ./...

# Update direct, indirect, and test dependencies
go get -u -t ./...
