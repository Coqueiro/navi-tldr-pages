; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/yapf.md

% yapf, common

# Simulate formatting and display a diff of the changes that would be made
yapf <__d___diff_> <path_to_file>

# Recursively format all Python files in a directory, concurrently
yapf {{[-ri|--recursive --in-place]}} --style <pep8> <__p___parallel_> <path_to_directory>
