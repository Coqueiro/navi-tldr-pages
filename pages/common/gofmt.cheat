; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/gofmt.md

% gofmt, common

# Format a file and display the result to the console
gofmt <path_to_source_go>

# Format a file, overwriting the original file in-place
gofmt -w <path_to_source_go>

# Format a file, and then simplify the code, overwriting the original file
gofmt -s -w <path_to_source_go>

# Display diffs instead of rewriting files
gofmt -d <path_to_source_go>

# List files that would be changed by gofmt
gofmt -l <path_to_directory>

# Apply a rewrite rule to the source before reformatting (e.g. replace nil checks with `isNil` calls)
gofmt -r '{{x == nil -> isNil(x)}}' <path_to_source_go>

# Report all errors, including multiple ones per line
gofmt -e <path_to_source_go>
