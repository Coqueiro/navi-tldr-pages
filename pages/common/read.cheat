; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/read.md

% read, common

# Store data that you type from the keyboard to one or more variable
read {{variable1 variable2 ...}}

# Store each of the next lines you enter as values of an array
read -a <array>

# Specify the number of maximum characters to be read
read -n <character_count> <variable>

# Assign multiple values to multiple variables
read <<< "{{The surname is Bond}}" {{_ variable1 _ variable2}}

# Do not let backslash (`\`) act as an escape character
read -r <variable>

# Display a prompt before the input
read -p "{{Enter your input here: }}" <variable>

# Do not echo typed characters (silent mode)
read -s <variable>

# Perform an action on each line of a command's output
<command> | while IFS= read -r line; do <echo_ls_rm____> "$line"; done
