; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/swaybg.md

% swaybg, common

# Set the wallpaper on all monitors to an image
swaybg <__i___image_> <path_to_image>

# Set the image scaling mode (default: `stretch`)
swaybg <__i___image_> <path_to_image> <__m___mode_> <stretch_fit_fill_center_tile_solid_color>

# Set the wallpaper to a static color
swaybg <__c___color_> <rrggbb>

# Set the wallpaper on a specific monitor
swaybg <__o___output_> <HDMI_1> <__i___image_> <path_to_image>

# Set different wallpapers on multiple monitors
swaybg <__o___output_> <HDMI_1> <__i___image_> <path_to_image> <__o___output_> <DP_1> <__i___image_> <path_to_image>
