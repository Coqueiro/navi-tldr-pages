; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/sass.md

% sass, common

# Convert an SCSS or Sass file to CSS and print out the result
sass <inputfile>.<scss_sass>

# Convert an SCSS or Sass file to CSS and save the result to a file
sass <inputfile>.<scss_sass> <outputfile_css>

# Watch an SCSS or Sass file for changes and output or update the CSS file with same filename
sass --watch <inputfile>.<scss_sass>

# Watch an SCSS or Sass file for changes and output or update the CSS file with the given filename
sass --watch <inputfile>.<scss_sass>:<outputfile_css>
