; https://github.com/tldr-pages/tldr/blob/master/pages/common/lore.md

% lore, common

# Clone an existing repository
lore clone <https___example_com_path_to_repository>

# Display the state of the working directory and staging area
lore status

# Commit changes with a specific message
lore commit "<message>"

# Create a new branch
lore branch create <branch_name>

# Start a service for a repository
lore service start

# Display help
lore help

# Display version
lore --version
