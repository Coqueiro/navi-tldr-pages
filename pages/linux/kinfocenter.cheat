; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/linux/kinfocenter.md

% kinfocenter, linux

# Open the GUI
kinfocenter

# List all possible KCM modules for `kinfocenter`
kinfocenter --list

# Open a specific KCM
kinfocenter <kcm_name>

# Display help
kinfocenter <__h___help_>
