; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/linux/pvesm.md

% pvesm, linux

# Get status for all datastores
pvesm <_st_status_>

# List storage contents
pvesm <_l_list_> <storage_name>

# View the path of a stored file
pvesm <_pa_path_> <storage_name>:<content_type>/<file_name>

# Add a directory storage
pvesm <_ad_add_> dir <storage_name> --path <path_to_directory>

# Set a storage to contain specific content
pvesm <_se_set_> <storage_name> --content <iso_images_backup_vztmpl_rootdir_snippets_import>

# Delete a file from storage
pvesm <_f_free_> <local_iso_archlinux_2025_08_01_x86_64_iso>

# Remove a storage
pvesm <_r_remove_> <storage_name>
