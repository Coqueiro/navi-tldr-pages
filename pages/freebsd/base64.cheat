; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/freebsd/base64.md

% base64, freebsd

# Encode a file to `stdout`
base64 <path_to_file>

# Wrap encoded output at a specific column width (`0` disables wrapping)
base64 -w <0_76____> <path_to_file>

# Decode a file to `stdout`
base64 -d <path_to_file>

# Encode from `stdin` to `stdout`
<command> | base64

# Decode from `stdin` to `stdout`
<command> | base64 -d
