; https://github.com/tldr-pages/tldr/blob/master/pages/linux/aa-remove-unknown.md

% aa-remove-unknown, linux

# Simulate removing profiles and display which ones would be removed
sudo aa-remove-unknown -n

# Actually remove the profiles
sudo aa-remove-unknown

# Display help
aa-remove-unknown <__h___help_>
