; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/linux/efibootmgr.md

% efibootmgr, linux

# List all boot options with their numbers
efibootmgr <__u___unicode_>

# Add a UEFI executable (e.g. UEFI shell, Unified Kernel Image, etc.) as a boot option
sudo efibootmgr <__c___create_> <__d___disk_> <_dev_sda> <__p___part_> <1> <__l___loader_> "<path_to_executable_efi>" <__L___label_> "<boot_entry_name>"

# Add Linux as a boot option
sudo efibootmgr <__c___create_> <__d___disk_> <_dev_sda> <__p___part_> <1> <__l___loader_> "<path_to_vmlinuz>" <__u___unicode_> "{{root=UUID=partition_uuid rw loglevel=3 initrd=path\to\initramfs-linux.img}}" <__L___label_> "<Linux>"

# Change the current boot order
sudo efibootmgr <__o___bootorder_> <0002_0008_0001_001A____>

# Delete a boot option
sudo efibootmgr <__B___delete_bootnum_> <__b___bootnum_> <0008>
