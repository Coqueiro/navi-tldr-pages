; https://github.com/tldr-pages/tldr/blob/master/pages/common/crane-registry.md

% crane-registry, common

# Serve a registry implementation
crane registry serve

# Specify the address to listen on
crane registry serve --address <address_name>

# Store blobs in a specific directory
crane registry serve --disk <path_to_directory>

# Display help for `crane registry`
crane registry <__h___help_>

# Display help for `crane registry serve`
crane registry serve <__h___help_>
