; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/linux/systemsettings.md

% systemsettings, linux

# Open the settings GUI
systemsettings

# List all possible KCM modules for `systemsettings`
systemsettings --list

# Open a specific KCM
systemsettings <kcm_name>

# Display help
systemsettings <__h___help_>
