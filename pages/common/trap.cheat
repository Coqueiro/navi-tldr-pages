; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/trap.md

% trap, common

# List the commands and the names of the expected events
trap

# Execute a command when a signal is received
trap 'echo "Caught signal <SIGHUP>"' <_HUP_SIGHUP_>

# Remove commands
trap - <_HUP_SIGHUP_> <_INT_SIGINT_>
