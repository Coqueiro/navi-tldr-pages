; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/linux/arch-update.md

% arch-update, linux

# Start the system update
arch-update

# List pending updates
arch-update <__l___list_>

# Start the systray applet and enable it automatically at boot
arch-update --tray --enable

# List the last 10 Arch Linux news posts
arch-update <__n___news_> 10
