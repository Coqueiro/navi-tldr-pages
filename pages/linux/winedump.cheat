; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/linux/winedump.md

% winedump, linux

# Dump the contents of a PE file, DLL, or executable
winedump dump <path_to_file_dll>

# Dump only the [f]ile header information
winedump dump -f <path_to_file_dll>

# Dump a specific section, such as the import or export table
winedump dump -j <import_export> <path_to_file_dll>

# Demangle a C++ (MSVC-mangled) symbol
winedump sym <mangled_symbol>

# Generate a `.spec` file and stub implementation code from a DLL
winedump spec <path_to_file_dll>

# Display help
winedump -h
