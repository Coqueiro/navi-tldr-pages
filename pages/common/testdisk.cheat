; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/testdisk.md

% testdisk, common

# Start TestDisk on a specific device
sudo testdisk <_dev_sdX>

# Start TestDisk on a disk image
sudo testdisk <path_to_image_dd>

# Start TestDisk and create a log file (`testdisk.log`)
sudo testdisk /log <_dev_sdX>

# List current partitions
sudo testdisk /list

# Display version
testdisk /version
