; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/gh-stack.md

% gh-stack, common

# Start a new stack interactively (creates and checks out the first branch)
gh stack init

# Start a new stack specifying branches upfront
gh stack init {{branch_name1 branch_name2 ...}}

# Add a branch on top of the stack
gh stack add <branch_name>

# Push all branches to the default remote
gh stack push

# Push all branches to a specified remote
gh stack push --remote <remote_name>

# View the stack
gh stack view

# Open a stack of PRs
gh stack submit
