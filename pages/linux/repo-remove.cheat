; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/linux/repo-remove.md

% repo-remove, linux

# Remove a package from a local repository
repo-remove <path_to_database_db_tar_gz> <package>

# Also remove the package file
repo-remove <__R___remove_> <path_to_database_db_tar_gz> <package>
