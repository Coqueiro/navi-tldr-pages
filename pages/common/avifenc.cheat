; This has been extracted from
; https://github.com/tldr-pages/tldr/blob/master/pages/common/avifenc.md

% avifenc, common

# Convert a specific PNG image to AVIF
avifenc <path_to_input>.png <path_to_output>.avif

# Encode with a specific speed (6=default, 0=slowest, and 10=fastest)
avifenc <__s___speed_> <0__10> <path_to_input_png> <path_to_output>.avif
